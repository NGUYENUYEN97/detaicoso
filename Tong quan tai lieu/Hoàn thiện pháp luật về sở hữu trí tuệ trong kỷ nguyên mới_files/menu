menu_ctrl = {
    menuVersionKey: "vszc",

    init: function () {
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", menu_ctrl.loadDataMenu);
        } else {
            menu_ctrl.loadDataMenu();
        }
    },

    loadDataMenu: function () {
        document.querySelectorAll(".zone-menu").forEach(function (item) {
            var zoneCode = item.getAttribute("data-zone");
            if (!zoneCode) {
                return;
            }

            try {
                var htmlZone = localStorage.getItem(zoneCode);
                if (htmlZone) {
                    item.innerHTML = htmlZone;
                }
            } catch (e) { }
        });

        menu_ctrl.initMenuTab();

        var vr = "";
        try {
            vr = localStorage.getItem(menu_ctrl.menuVersionKey) || "";
        } catch (e) { }

        var xhr = new XMLHttpRequest();
        xhr.open("POST", "/Misc/GetDataMenuZone", true);
        xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
        xhr.onreadystatechange = function () {
            if (xhr.readyState === 4 && xhr.status === 200) {
                try {
                    var rs = JSON.parse(xhr.responseText);
                    menu_ctrl.loadData(rs.DataZoneMenu || [], rs.DataVr || "");
                } catch (e) {
                    console.error("Parse menu data error:", e);
                }
            }
        };
        xhr.send("&vr=" + encodeURIComponent(vr));
    },

    loadData: function (listItem, vs) {
        if (!listItem || !listItem.length) {
            return;
        }

        document.querySelectorAll(".zone-menu").forEach(function (el) {
            if (el) {
                el.innerHTML = "";
            }
        });

        for (var i = 0; i < listItem.length; i++) {
            var item = listItem[i];
            if (!item || !item.ZoneCode) {
                continue;
            }

            var zonecode = item.ZoneCode;
            var zone_ = document.querySelector('.zone-menu[data-zone="' + zonecode.replace(/"/g, '\\"') + '"]');
            if (!zone_) {
                continue;
            }

            if (item.Html && item.Html.length > 10) {
                zone_.innerHTML = item.Html;
            } else {
                var type = parseInt(item.Type, 10);
                if (isNaN(type)) {
                    continue;
                }

                var themeItem = menu_ctrl.getThemeZoneItem(type);
                if (!themeItem) {
                    continue;
                }

                zone_.innerHTML += themeItem;

                var zone_append = zone_.querySelector(".zone-append");
                if (zone_append && item.ListParent && item.ListParent.length) {
                    for (var k = 0; k < item.ListParent.length; k++) {
                        var parent = item.ListParent[k];
                        if (!parent) {
                            continue;
                        }

                        var div = document.createElement("div");

                        var menuHTML = menu_ctrl.getThemeZoneItemFist(type)
                            .replaceAll("{{link}}", parent.Link || "#")
                            .replaceAll("{{name}}", parent.Name || "")
                            .replaceAll("{{title}}", parent.Name || "")
                            .replaceAll("{{cate}}", parent.CateId || "");

                        if (type === 2 && k === 5) {
                            var contactBox = `
                                <div class="w-20-100 fl mb25">
                                    <div class="flex">
                                        <div class="border-bottom__white w-full"></div>
                                        <div class="item-box-menu"></div>
                                    </div>
                                    <div class="mt10 pl25 font15 font-helvetica">
                                        <div class="pt10"><span class="bold color-blue-7 uppercase">Liên hệ tòa soạn</span></div>
                                        <div class="pt10 font20"><span class="bold white"><i class="icon-phone mr2"></i> 0947271302</span></div>
                                        <div class="pt10"><span class="bold color-blue-7 uppercase">Liên hệ quảng cáo</span></div>
                                        <div class="pt10"><span class="white">Ms Linh<span class="bold ml2"> 098 9033388</span></span></div>
                                    </div>
                                </div>`;

                            div.innerHTML = contactBox;
                            if (div.firstChild) {
                                zone_append.appendChild(div.firstChild);
                            }
                        }

                        div.innerHTML = menuHTML;

                        if (parent.IsSearchChild === 1 && parent.ListChild && parent.ListChild.length > 0) {
                            menu_ctrl.initZoneChild(type, parent.ListChild, div);
                        }

                        if (div.firstChild) {
                            zone_append.appendChild(div.firstChild);
                        }
                    }
                }
            }

            try {
                localStorage.setItem(zonecode, zone_.innerHTML);
            } catch (e) { }
        }

        try {
            localStorage.setItem(menu_ctrl.menuVersionKey, vs);
        } catch (e) { }

        menu_ctrl.initMenuTab();
        menu_ctrl.initEvent();
    },

    initZoneChild: function (type, ListChild, div) {
        var zone_child = div.querySelector(".zone-child");
        if (!zone_child || !ListChild) {
            return;
        }

        for (var k = 0; k < ListChild.length; k++) {
            var child = ListChild[k];
            var childHTML = "";

            if (type === 2 || type === 3) {
                var classHide = k > 4 ? " menu-hide hide" : "";
                childHTML = '<li class="' + classHide.trim() + ' pt5"><a href="' + (child.Link || "#") + '" class="font13" title="' + (child.Name || "") + '">' + (child.Name || "") + "</a></li>";
            } else if (type === 1) {
                childHTML = '<li class="menu-tab" data-cate="' + (child.CateId || "") + '"><a href="' + (child.Link || "#") + '" title="' + (child.Name || "") + '">' + (child.Name || "") + "</a></li>";
            } else if (type === 5 || type === 8) {
                childHTML = '<li data-cate="' + (child.CateId || "") + '"><a href="' + (child.Link || "#") + '" title="' + (child.Name || "") + '">' + (child.Name || "") + "</a></li>";
            }

            if (childHTML) {
                var childNode = menu_ctrl.getElm(childHTML);
                if (childNode) {
                    zone_child.appendChild(childNode);
                }
            }
        }
    },

    initMenuTab: function () {
        menu_ctrl.initMenuTabMobile();
    },

    initMenuTabMobile: function () {
        var input_cate = document.querySelector("input.id-category");
        var pageInput = document.querySelector("input#page_view");
        var page = pageInput ? pageInput.value : "";

        if (!input_cate || !input_cate.getAttribute("data-id")) {
            return;
        }

        var zone_menu_tab = document.querySelector('.zone-menu[data-zone="zone_sub_menu_mobile"]');
        if (!zone_menu_tab) {
            return;
        }

        var id_cate = input_cate.getAttribute("data-id");
        var menu_active = zone_menu_tab.querySelector('.menu-tab[data-cate="' + id_cate + '"]');
        if (!menu_active) {
            return;
        }

        var ul = zone_menu_tab.querySelector(".ul-set-menu");
        var ul_son = zone_menu_tab.querySelector(".ul-set-menu-son");
        if (!ul || !ul_son) {
            return;
        }

        if (menu_active.classList.contains("parent-menu")) {
            var nameParent = menu_active.getAttribute("data-name") || "";
            var linkParent = menu_active.getAttribute("data-link") || "#";

            ul.innerHTML = `
                <li class="pl5 pt5 mr10 li-icon"><a href="/" class="pl10 pr10 tc bold"><i class="fa fa-home color-blue-1 font16"></i></a></li>
                <li class="pr5 li-bot"><h1><a href="${linkParent}" class="color-blue-1 font14 pl10 pr10 uppercase">${nameParent}</a></h1></li>
            `;

            menu_active.querySelectorAll("li").forEach(function (child) {
                var nameChild = child.getAttribute("data-name") || "";
                var linkChild = child.getAttribute("data-link") || "#";
                var li = menu_ctrl.getElm('<li class="relative"><a href="' + linkChild + '" class="bg-white pl10 pr10 radius-3">' + nameChild + "</a></li>");
                if (li) {
                    ul_son.appendChild(li);
                }
            });
        } else {
            var parent = menu_active.closest(".parent-menu");
            if (!parent) {
                return;
            }

            var nameParent = parent.getAttribute("data-name") || "";
            var linkParent = parent.getAttribute("data-link") || "#";
            var nameChild = menu_active.getAttribute("data-name") || "";
            var linkChild = menu_active.getAttribute("data-link") || "#";

            ul.innerHTML = `
                <li class="pl5 pt5 mr10 li-icon"><a href="/" class="pl10 pr10 tc bold"><i class="fa fa-home color-blue-1 font16"></i></a></li>
                <li class="pr5 li-bot"><h1><a href="${linkParent}" class="color-blue-1 font14 pl10 pr10 uppercase">${nameParent}</a></h1></li>
            `;

            ul_son.innerHTML = '<li class="relative"><a href="' + linkChild + '" class="bg-white pl10 pr10 radius-3 color-blue-1">' + nameChild + "</a></li>";
        }

        if (page === "detail") {
            var spanMenu = document.querySelector(".span-set-menu");
            if (spanMenu && !menu_active.classList.contains("parent-menu")) {
                var detailParent = menu_active.closest(".parent-menu");
                if (detailParent) {
                    spanMenu.innerHTML = '<a href="' + (detailParent.getAttribute("data-link") || "#") + '" title="' + (detailParent.getAttribute("data-name") || "") + '" class="color-blue-1 font18 opensans-bold">' + (detailParent.getAttribute("data-name") || "") + '<i class="fa fa-angle-double-right pl10 pr10 text-crumb"></i></a>';
                }
            }
        }
    },

    initEvent: function () {
        document.querySelectorAll('.zone-menu[data-zone="menu_ex_pc"], .zone-menu[data-zone="zone_menu_bot"]').forEach(function (area) {
            area.addEventListener("click", function (e) {
                if (e.target.classList.contains("view-more-menu")) {
                    var hides = e.target.closest("div").querySelectorAll(".menu-hide");
                    hides.forEach(function (item) {
                        item.classList.toggle("hide");
                    });
                    e.target.textContent = e.target.textContent.trim() === "Xem thêm" ? "Thu gọn" : "Xem thêm";
                }
            });
        });

        var menuOther = document.querySelector(".btn-menu-other");
        if (menuOther) {
            menuOther.addEventListener("click", function () {
                var box = document.querySelector(".box-other-menu");
                if (box) {
                    box.classList.toggle("hide");
                    this.innerHTML = box.classList.contains("hide")
                        ? '<i class="icon-menu"></i>'
                        : '<i class="fa fa-times item-icon"></i>';
                }
            });
        }

        var acMenu = document.querySelector(".ac-menu");
        if (acMenu) {
            acMenu.addEventListener("click", function () {
                document.body.classList.toggle("show_menu");
            });
        }

        document.querySelectorAll(".cl-menu").forEach(function (btn) {
            btn.addEventListener("click", function () {
                document.body.classList.remove("show_menu");
            });
        });

        document.querySelectorAll("li.sub").forEach(function (item) {
            var plus = item.querySelector(".ti-plus");
            var minus = item.querySelector(".ti-minus");
            var childUl = item.querySelector(".zone-child");

            if (plus && childUl) {
                plus.addEventListener("click", function (e) {
                    e.stopImmediatePropagation();

                    document.querySelectorAll("li.sub.active").forEach(function (other) {
                        if (other !== item) {
                            other.classList.remove("active");
                        }
                    });

                    item.classList.toggle("active");
                });
            }

            if (minus && childUl) {
                minus.addEventListener("click", function (e) {
                    e.stopImmediatePropagation();
                    item.classList.remove("active");
                });
            }
        });
    },

