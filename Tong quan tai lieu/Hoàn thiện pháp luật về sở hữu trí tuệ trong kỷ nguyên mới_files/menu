/* ===== Home ad slider: tự động trượt, dots chỉ hiển thị (không click) ===== */
(function () {
    function initAdSlider(root) {
        var track = root.querySelector('.home-adslider-track');
        var slides = root.querySelectorAll('.home-adslider-slide');
        var dots = root.querySelectorAll('.home-adslider-dot');
        var total = slides.length;
        if (!track || total <= 1) {
            return;
        }

        var index = 0;
        var delay = parseInt(root.getAttribute('data-autoplay'), 10) || 4000;
        var timer = null;

        function go(i) {
            index = (i + total) % total;
            track.style.transform = 'translateX(' + (-index * 100) + '%)';
            for (var d = 0; d < dots.length; d++) {
                dots[d].classList.toggle('is-active', d === index);
            }
        }

        function start() {
            stop();
            timer = setInterval(function () { go(index + 1); }, delay);
        }

        function stop() {
            if (timer) { clearInterval(timer); timer = null; }
        }

        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);

        go(0);
        start();
    }

    function initAllAdSliders() {
        var sliders = document.querySelectorAll('.home-adslider');
        for (var i = 0; i < sliders.length; i++) {
            initAdSlider(sliders[i]);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAllAdSliders);
    } else {
        initAllAdSliders();
    }
})();

/* ===== Home side banner (hot_banner_4–7): riêng, chỉ slide có dữ liệu mới chạy ===== */
(function () {
    function slideHasAdData(slide) {
        if (!slide) return false;
        var box = slide.querySelector('.ads-item') || slide;
        if (box.querySelector('img, iframe, a, video, object, embed')) return true;
        var ins = box.querySelector('ins');
        if (!ins) return false;
        if (ins.children.length > 0) return true;
        var html = (ins.innerHTML || '').replace(/<script[\s\S]*?<\/script>/gi, '').replace(/\s+/g, '');
        return html.length > 0;
    }

    function allSlides(root) {
        return Array.prototype.slice.call(root.querySelectorAll('.home-sidebanner-slide'));
    }

    function cycleSlides(root) {
        var all = allSlides(root);
        var filled = [];
        for (var i = 0; i < all.length; i++) {
            if (slideHasAdData(all[i])) filled.push(all[i]);
        }
        if (filled.length >= 2) return filled;
        if (filled.length === 1 && root.getAttribute('data-sb-settled') === '1') return filled;
        return all;
    }

    function initHomeSideBanner(root) {
        if (!root || root.getAttribute('data-sb-on') === '1') return;
        root.setAttribute('data-sb-on', '1');

        var list = allSlides(root);
        if (!list.length) return;

        var index = 0;
        var delay = parseInt(root.getAttribute('data-autoplay'), 10) || 3500;
        var timer = null;
        var refreshTimer = null;

        function setActive(i) {
            var cycle = cycleSlides(root);
            if (!cycle.length) return;
            index = ((i % cycle.length) + cycle.length) % cycle.length;

            var active = cycle[index];
            var all = allSlides(root);
            for (var s = 0; s < all.length; s++) {
                if (all[s] === active) all[s].classList.add('is-active');
                else all[s].classList.remove('is-active');
            }
        }

        function start() {
            stop();
            if (cycleSlides(root).length <= 1) return;
            timer = setInterval(function () { setActive(index + 1); }, delay);
        }

        function stop() {
            if (timer) { clearInterval(timer); timer = null; }
        }

        function refresh() {
            clearTimeout(refreshTimer);
            refreshTimer = setTimeout(function () {
                setActive(index);
                start();
            }, 80);
        }

        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);

        if (!root.querySelector('.home-sidebanner-slide.is-active')) {
            list[0].classList.add('is-active');
        }

        setActive(0);
        start();

        if (window.MutationObserver) {
            var obs = new MutationObserver(refresh);
            obs.observe(root, { childList: true, subtree: true });
        }

        window.addEventListener('load', refresh);
        setTimeout(refresh, 2000);
        setTimeout(function () {
            root.setAttribute('data-sb-settled', '1');
            refresh();
        }, 5000);
    }

    function initAll() {
        var roots = document.querySelectorAll('.home-sidebanner');
        for (var i = 0; i < roots.length; i++) {
            initHomeSideBanner(roots[i]);
        }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(initAll, 0);
    } else {
        document.addEventListener('DOMContentLoaded', initAll);
    }
    window.addEventListener('load', initAll);
})();

